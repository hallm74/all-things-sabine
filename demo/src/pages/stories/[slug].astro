---
import Layout from "../../layouts/Layout.astro";
import { stories } from "../../lib/content";
import { newsDate as readableDate } from "../../lib/news";
export function getStaticPaths() {
  return stories.map(story => ({
    params: { slug: story.slug },
    props: { story },
  }));
}
const { story } = Astro.props;
const isNews = story.tags.some(tag => tag.toLowerCase() === "news");
const related = stories.filter(s => s.tags.some(tag => tag.toLowerCase() === "news") === isNews);
const index = related.findIndex(s => s.slug === story.slug);
const next = related.length > 1 ? related[(index + 1) % related.length] : undefined;
---

<Layout title={story.title} description={story.description} image={story.image} activeSection={isNews ? "/news/" : "/stories/"}
  ><main id="main-content" class="wrap">
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href={isNews ? "/news/" : "/stories/"}>{isNews ? "News" : "Stories"}</a>
    </div><header class="article-header">
      <span class="eyebrow">{isNews ? "All Things Sabine news" : "From the All Things Sabine collection"}</span><h1>
        {story.title}
      </h1><div class="article-meta">
        {story.author && <span
          >By {
            story.author.toLowerCase() === "shannon"
              ? "Shannon Hall"
              : story.author
          }</span>}<time datetime={story.date}
          >Originally published {readableDate(story.date)}</time>
      </div>
    </header><article class="article-body" set:html={story.html} /><nav
      class="article-nav"
      aria-label="More stories"
    >
      <a href={isNews ? "/news/" : "/stories/"}>{isNews ? "← Back to News" : "← Back to all stories"}</a>{next && <a href={next.href}>{isNews ? "Another news article →" : "Another story →"}</a>}
    </nav>
  </main></Layout
>
