---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import StoryCard from "../components/StoryCard.astro";
import { stories, archive, storyBy } from "../lib/content";
import { directoryItems, eventDate } from "../lib/directories";
const lead = storyBy("miller-store");
const side = [storyBy("a-community-lost"), storyBy("rock-chapel")];
const picks = [
  storyBy("kisatchie-bayou"),
  storyBy("early-1900-s-train") || storyBy("train-wreck"),
  storyBy("toledo-bend-damsite"),
].filter(Boolean);
const archivePicks = ["1987-black-heritage", "old-photos", "zwolle"]
  .map(term => archive.find(s => s.slug.includes(term) && s.image))
  .filter(Boolean);
const capsuleImage = archivePicks[0] || archive.find(s => s.image)!;
const festivals = directoryItems("festivals")
  .filter(
    f =>
      f.endDate! >=
      new Intl.DateTimeFormat("en-CA", { timeZone: "America/Chicago" }).format(
        new Date()
      )
  )
  .slice(0, 3);
const explore = [
  {
    key: "menus",
    label: "Find your next bite",
    text: "Local flavor. Menus made easy.",
    count: directoryItems("menus").length + " places to eat",
  },
  {
    key: "listings",
    label: "Keep it local",
    text: "Good businesses. Familiar faces.",
    count: "Explore local businesses",
  },
  {
    key: "community",
    label: "Find your people",
    text: "Resources, programs & connection.",
    count: "Connect with your community",
  },
  {
    key: "festivals",
    label: "Make a memory",
    text: "Gatherings worth getting out for.",
    count: "See what’s coming up",
  },
];
---

<Layout>
  <main id="main-content">
    <section class="home-intro wrap">
      <div>
        <span class="eyebrow"
          >Sabine Parish, Louisiana & the places we call home</span
        ><h1>
          A little history.<br class="mobile-break" />
          <em>A lot of home.</em>
        </h1>
      </div><p>
        <span>Stories that take you back. </span><span
          >Places that bring us together.
        </span><span>Discover Sabine, then and now.</span>
      </p>
    </section>
    <section class="hero-grid wrap" aria-label="Featured stories">
      <a class="lead-story" href={lead.href}
        ><img
          src={lead.image}
          alt="The historic J. M. Miller Store in Toro, with its old gas pumps"
          width="1024"
          height="576"
          fetchpriority="high"
        /><div class="lead-shade"></div><div class="lead-copy">
          <span class="light-label">The places that remember</span><h2>
            If these walls<br />could talk.
          </h2><p>
            A stop at Miller Store, and a journey into the heart of Toro.
          </p><span class="light-link"
            >Read the story <Icon name="arrow" /></span>
        </div><span class="photo-location"
          ><Icon name="pin" size={14} /> Toro, Louisiana</span
        ></a
      >
      <div class="hero-side">
        {
          side.map((story, index) => (
            <a href={story.href} class="side-story">
              <>
                <img src={story.image} alt="" width="560" height="300" />
                <div>
                  <>
                    <span class="eyebrow">
                      {index === 0
                        ? "Beneath Toledo Bend"
                        : "Along the back roads"}
                    </span>
                    <h2>
                      {index === 0
                        ? "A community lost. A history remembered."
                        : "A little chapel. An enduring story."}
                    </h2>
                    <span class="mini-arrow" aria-hidden="true">
                      ↗
                    </span>
                  </>
                </div>
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class="explore-section wrap">
      <div class="section-heading compact">
        <h2>Your everyday Sabine</h2><span class="section-note"
          >A few good reasons to stay awhile.</span>
      </div><div class="explore-grid">
        {
          explore.map((item, i) => (
            <a
              href={`/${item.key}/`}
              class={`explore-card explore-${item.key}`}
            >
              <>
                <div class="explore-top">
                  <>
                    <Icon name={item.key} />
                    <span>
                      0{i + 1} / {item.key}
                    </span>
                    <span class="explore-arrow" aria-hidden="true">
                      ↗
                    </span>
                  </>
                </div>
                <h3>{item.label}</h3>
                <p>{item.text}</p>
                <span class="explore-bottom">{item.count}</span>
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class="capsule-band">
      <div class="wrap capsule-inner">
        <div class="capsule-copy">
          <span class="eyebrow">The Time Capsule</span><h2>
            Some things<br />deserve to<br /><em>be remembered.</em>
          </h2><p>
            Old photographs. Familiar faces. The little moments that became our
            history. Step inside the All Things Sabine Facebook archive.
          </p><a class="button dark" href="/time-capsule/"
            >Open the Time Capsule <Icon name="arrow" /></a
          ><span class="capsule-count"
            >{archive.length.toLocaleString()} preserved posts. Countless memories.</span>
        </div><div class="capsule-photos">
          <a class="paper-photo back-photo" href={side[0].href}
            ><img
              src={side[0].image}
              alt="Pine Flat School from the original story collection"
              loading="lazy"
            /><span>Pine Flat · A community remembered</span></a
          ><a class="paper-photo front-photo" href={capsuleImage.href}
            ><img
              src={capsuleImage.image}
              alt={capsuleImage.title}
              loading="lazy"
            /><span
              >{capsuleImage.title} <span aria-hidden="true">↗</span></span
            ></a
          ><div class="archive-stamp">
            OUR PEOPLE<br /><strong>OUR PAST</strong><br />OUR SABINE
          </div>
        </div>
      </div>
    </section>
    <section class="stories-section wrap">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Take the scenic route</span><h2>
            There’s a story around every bend.
          </h2>
        </div><a class="text-link" href="/stories/"
          >All {stories.length} stories <Icon name="arrow" /></a>
      </div><div class="story-grid">
        {
          picks.map(story => (
            <StoryCard
              story={story}
              label={story.tags[0] || "Places & memories"}
            />
          ))
        }
      </div>
    </section>
    <section class="happenings">
      <div class="wrap">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Save a date. Bring a friend.</span><h2>
              Around here, we get together.
            </h2>
          </div><a class="text-link" href="/festivals/"
            >Explore festivals <Icon name="arrow" /></a>
        </div><div class="event-grid">
          {
            festivals.map(event => (
              <a href={event.href} class="event-card">
                <>
                  <span class="event-date">
                    <strong>{eventDate(event.date!).split(" ")[1]}</strong>
                    {eventDate(event.date!).split(" ")[0]}{" "}
                    {event.date!.slice(0, 4)}
                  </span>
                  <div>
                    <>
                      <span class="eyebrow">{event.location}</span>
                      <h3>{event.name}</h3>
                      <p>
                        {eventDate(event.date!)}
                        {event.endDate !== event.date
                          ? " – " + eventDate(event.endDate!)
                          : ""}
                      </p>
                      <span class="text-link">See the schedule ↗</span>
                    </>
                  </div>
                </>
              </a>
            ))
          }
        </div><p class="event-source">
          Dates from Sabine Festivals. Check the full schedule for details and
          organizer updates.
        </p>
      </div>
    </section>
    <section class="closing wrap">
      <span class="eyebrow">Yesterday, today & whatever comes next</span><h2>
        This is our corner of Louisiana.<br /><em>Make yourself at home.</em>
      </h2><a class="text-link" href="/about/"
        >The story behind All Things Sabine <Icon name="arrow" /></a>
    </section>
  </main>
</Layout>
